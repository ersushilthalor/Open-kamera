<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_background"
    tools:context=".MainActivity" >

    <!-- Live Camera Viewfinder -->
    <FrameLayout
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        />

    <!-- Modern Stock Shutter Button -->
    <ImageButton
        android:id="@+id/take_photo"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/take_photo"
        android:src="@drawable/take_photo_selector"
        android:onClick="clickedTakePhoto"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_marginBottom="24dp"
        android:elevation="6dp"
        />

    <!-- Zoom Controls -->
    <ZoomControls
        android:id="@+id/zoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:layout_above="@+id/take_photo"
        android:layout_centerHorizontal="true"
        android:visibility="gone"
        />

    <!-- Modern Zoom Slider -->
    <SeekBar
        android:id="@+id/zoom_seekbar"
        android:layout_width="180dp"
        android:layout_height="40dp"
        android:layout_above="@+id/switch_video"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_pill_surface"
        android:progressDrawable="@drawable/seekbar_track"
        android:thumb="@drawable/seekbar_thumb"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:splitTrack="false"
        android:elevation="4dp"
        />
    
    <!-- Modern Focus Distance Slider -->
    <SeekBar
        android:id="@+id/focus_seekbar"
        android:layout_width="180dp"
        android:layout_height="40dp"
        android:layout_above="@+id/zoom_seekbar"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_pill_surface"
        android:progressDrawable="@drawable/seekbar_track"
        android:thumb="@drawable/seekbar_thumb"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:splitTrack="false"
        android:visibility="invisible"
        android:elevation="4dp"
        />
    
    <!-- Anchor for Top GUI Controls Flow -->
    <Button
        android:id="@+id/gui_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:padding="0dp"
        android:scaleType="fitCenter"
        />

    <!-- Modern Settings Button -->
    <ImageButton
        android:id="@+id/settings"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/gui_anchor"
        android:layout_margin="8dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/action_settings"
        android:src="@drawable/settings"
        android:background="@drawable/bg_circle_button"
        android:onClick="clickedSettings"
        android:elevation="4dp"
        />

    <!-- Modern Gallery Thumbnail Button -->
    <ImageButton
        android:id="@+id/gallery"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="28dp"
        android:layout_marginBottom="42dp"
        android:padding="12dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/gallery"
        android:src="@drawable/gallery"
        android:background="@drawable/bg_circle_button"
        android:onClick="clickedGallery"
        android:elevation="4dp"
        />

    <!-- Modern Popup Quick Controls Button -->
    <ImageButton
        android:id="@+id/popup"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/settings"
        android:layout_margin="8dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/action_popup"
        android:src="@drawable/popup"
        android:background="@drawable/bg_circle_button"
        android:onClick="clickedPopupSettings"
        android:elevation="4dp"
        />
    
    <!-- Modern Exposure Lock Button -->
    <ImageButton
        android:id="@+id/exposure_lock"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/popup"
        android:layout_margin="8dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/exposure_lock"
        android:src="@drawable/exposure_unlocked"
        android:background="@drawable/bg_circle_button"
        android:onClick="clickedExposureLock"
        android:elevation="4dp"
        />

    <!-- Modern Exposure Compensation Button -->
    <ImageButton
        android:id="@+id/exposure"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/exposure_lock"
        android:layout_margin="8dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/exposure"
        android:src="@drawable/exposure"
        android:background="@drawable/bg_circle_button"
        android:onClick="clickedExposure"
        android:elevation="4dp"
        />

    <!-- Modern Mode Switch Button -->
    <ImageButton
        android:id="@+id/switch_video"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_above="@+id/take_photo"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/switch_video"
        android:src="@drawable/switch_video"
        android:background="@drawable/bg_circle_button"
        android:onClick="clickedSwitchVideo"
        android:elevation="4dp"
        />

    <!-- Modern Switch Camera Button -->
    <ImageButton
        android:id="@+id/switch_camera"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="28dp"
        android:layout_marginBottom="42dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/switch_camera"
        android:src="@drawable/switch_camera"
        android:background="@drawable/bg_circle_button"
        android:onClick="clickedSwitchCamera"
        android:elevation="4dp"
        />

    <!-- Modern Trash Action Button -->
    <ImageButton
        android:id="@+id/trash"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/exposure"
        android:layout_margin="8dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/trash"
        android:src="@drawable/trash"
        android:background="@drawable/bg_circle_button"
        android:onClick="clickedTrash"
        android:visibility="gone"
        android:elevation="4dp"
        />

    <!-- Modern Share Action Button -->
    <ImageButton
        android:id="@+id/share"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/trash"
        android:layout_margin="8dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/share"
        android:src="@drawable/share"
        android:background="@drawable/bg_circle_button"
        android:onClick="clickedShare"
        android:visibility="gone"
        android:elevation="4dp"
        />

    <!-- Modern EV Exposure Seekbar -->
    <SeekBar
        android:id="@+id/exposure_seekbar"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_pill_surface"
        android:progressDrawable="@drawable/seekbar_track"
        android:thumb="@drawable/seekbar_thumb"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:splitTrack="false"
        android:elevation="8dp"
        />

    <ZoomControls
        android:id="@+id/exposure_seekbar_zoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:elevation="8dp"
        />

    <!-- Modern ISO Seekbar -->
    <SeekBar
        android:id="@+id/iso_seekbar"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_pill_surface"
        android:progressDrawable="@drawable/seekbar_track"
        android:thumb="@drawable/seekbar_thumb"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:splitTrack="false"
        android:elevation="8dp"
        />

    <!-- Modern Exposure Time (Shutter Speed) Seekbar -->
    <SeekBar
        android:id="@+id/exposure_time_seekbar"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_pill_surface"
        android:progressDrawable="@drawable/seekbar_track"
        android:thumb="@drawable/seekbar_thumb"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:splitTrack="false"
        android:elevation="8dp"
        />

    <!-- Preferences Container (Hidden by default, shown when settings open) -->
    <FrameLayout
        android:id="@+id/prefs_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:visibility="gone"
        />
    
    <FrameLayout
        android:id="@+id/locker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        />

    <!-- Modern Material 3 Floating Popup Container -->
    <ScrollView
        android:id="@+id/popup_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/settings"
        android:layout_below="@+id/settings"
        android:background="@drawable/bg_popup_surface"
        android:padding="12dp"
        android:elevation="12dp"
        android:overScrollMode="never"
        />
    
    <ScrollView
        android:id="@+id/hide_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        />
    
</RelativeLayout>
